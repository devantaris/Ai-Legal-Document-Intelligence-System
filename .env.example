# ============================================================
# AI Legal Document Intelligence System — environment config
# Copy to .env and fill in the values.
# ============================================================

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database & Redis (docker-compose provides both) ---
DATABASE_URL=postgresql+psycopg://legal:legal@localhost:5433/legal_ai
REDIS_URL=redis://localhost:6379/0

# --- File storage: local | s3 ---
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# S3 / MinIO / Cloudflare R2 object storage (only if STORAGE_BACKEND=s3)
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_BUCKET_NAME=legaliq-contracts
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# --- LLM provider: ollama (local, sovereign default) | zai (hosted) ---
LLM_PROVIDER=ollama

# Z.ai (https://z.ai) — OpenAI-compatible endpoint (only for LLM_PROVIDER=zai)
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_LLM_MODEL=glm-4.6
ZAI_EMBED_MODEL=embedding-3

# Ollama (https://ollama.com) — local sovereign models (only for LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector dimension — MUST match your embedding model:
#   Ollama nomic-embed-text -> 768
#   Z.ai embedding-3        -> 1024 (requested explicitly via the API)
# Changing this after ingesting documents requires re-ingesting them.
EMBEDDING_DIM=768

# --- RAG tuning ---
RETRIEVAL_TOP_K=6
CHUNK_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
