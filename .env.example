# ============================================================
# AI Legal Document Intelligence System — environment config
# Copy to .env and fill in the values.
# ============================================================

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database (docker-compose provides this) ---
DATABASE_URL=postgresql+psycopg://legal:legal@localhost:5433/legal_ai

# --- File storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# --- LLM provider: zai | ollama ---
LLM_PROVIDER=zai

# Z.ai (https://z.ai) — OpenAI-compatible endpoint
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_LLM_MODEL=glm-4.6
ZAI_EMBED_MODEL=embedding-3

# Ollama (https://ollama.com) — local models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector dimension — MUST match your embedding model:
#   Z.ai embedding-3        -> 1024 (requested explicitly via the API)
#   Ollama nomic-embed-text -> 768
# Changing this after ingesting documents requires re-ingesting them.
EMBEDDING_DIM=1024

# --- RAG tuning ---
RETRIEVAL_TOP_K=6
CHUNK_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
